@nsobid-0EFFE4AF1DEC3A7966B934D4A7C3D2BF566A9C62

# Paper Mario: The Thousand-Year Door 1.0.1 - 3840x2160 docked, 1280x720 handheld

@flag print_values
@flag offset_shift 0x100

// Renders at 3840x2160 docked and 1280x720 handheld.
// Do not combine with the Lighting Fix mod: it only hides the corruption
// fixed here by disabling spot lights and default point-light intensity.
//
// REQUIRES Ryujinx > System > DRAM Size set to 8 GiB for the enlarged
// render-target pool.

@enabled
// Texture allocator (sub_710024F058). Resize handlers recreate each render
// target at the pool offset it got when first created, sized for the stock
// 1600x900 docked resolution. Any target grown past that allocation spills
// into the next texture in the pool, which corrupts the G-buffer and
// tile-lighting targets; the corruption scales with resolution. The size
// reserved for each texture is recorded in its unused info-struct slot
// (+0x38), and a resize that needs more than that gets a fresh allocation.
0024F0F0 891A80B9
0024F0F4 AA0E098B
0024F0F8 4A0D58F9
0024F0FC 971240F9
0024F100 3F050031
0024F104 F7028A9A
0024F108 180B0012
0024F10C 9B0A40F9
0024F110 E00315AA
0024F114 E1031BAA
0024F118 05DFFE97   // BL  sub_7100206D2C (storage size)
0024F11C F60300AA
0024F120 E00315AA
0024F124 E1031BAA
0024F128 EADEFE97   // BL  sub_7100206CD0 (alignment)
0024F12C 681F40F9   // reserved size
0024F130 DF0208EB
0024F134 09010054   // fits: reuse the existing offset
0024F138 E8B240F9
0024F13C 090400D1
0024F140 0801098B
0024F144 1301298A
0024F148 6802168B
0024F14C E8B200F9
0024F150 761F00F9   // record reservation
// Pool_Invisible (render targets) size, stock 0x14180000 (321 MB). Leaves room
// for every resizable target at this resolution plus its original slot. Kept
// under 2 GiB because the pool builder receives the size as a 32-bit field.
0030A220 08E0AF52   // MOVZ W8,#0x7F00,LSL#16 = 2032 MB
// Docked render size (sub_710030EE08 / sub_710030EEF8, both config paths).
// 3840x2160 also enables the engine's built-in 4K branches for every
// output-size selector, so no further output-size sites are needed.
0030EECC 090E8152   // MOVZ W9,#0x870
0030EED0 08E08152   // MOVZ W8,#0xF00
0030F044 090E8152   // MOVZ W9,#0x870
0030F048 08E08152   // MOVZ W8,#0xF00
0030EE84 09E08152   // MOVZ W9,#0xF00
0030EE90 0A0E8152   // MOVZ W10,#0x870
0030EF80 09E08152   // MOVZ W9,#0xF00
0030EF8C 0A0E8152   // MOVZ W10,#0x870
// Handheld render size (sub_710030ED1C / sub_710030EEF8, both config paths).
0030EDE0 095A8052   // MOVZ W9,#0x2D0
0030EDE4 08A08052   // MOVZ W8,#0x500
0030F080 095A8052   // MOVZ W9,#0x2D0
0030F084 08A08052   // MOVZ W8,#0x500
0030ED98 09A08052   // MOVZ W9,#0x500
0030EDA4 0A5A8052   // MOVZ W10,#0x2D0
0030EFFC 09A08052   // MOVZ W9,#0x500
0030F008 0A5A8052   // MOVZ W10,#0x2D0
// Docked output size: window texture, scan-out crop, pre_hud buffer, viewport.
0030A24C 080E8152   // MOVZ W8,#0x870
0030A25C 09E0C1F2   // MOVK X9,#0xF00,LSL#32
0030AA7C 08E081D2   // MOVZ X8,#0xF00
0030AA88 080EC1F2   // MOVK X8,#0x870,LSL#32
0030E4AC 020E8152   // MOVZ W2,#0x870
0030E4B0 01E08152   // MOVZ W1,#0xF00
0030E768 040E8152   // MOVZ W4,#0x870
0030E774 03E08152   // MOVZ W3,#0xF00
00364A54 08E08152   // MOVZ W8,#0xF00
00364A5C 0A0E8152   // MOVZ W10,#0x870
0030FC20 09E08152   // MOVZ W9,#0xF00
0030FC28 0A0E8152   // MOVZ W10,#0x870
0030FC1C 0BAEA852   // MOVZ W11,#0x4570,LSL#16 = 3840.0f
0030FC2C EBA0A852   // MOVZ W11,#0x4507,LSL#16 = 2160.0f
// Tile-lighting light-list buffer (sub_710037A8B0). The engine sizes it for
// 120x68 tiles x 2048 bytes, the 16 px tile grid of a 1920x1080 frame, while
// the culling compute dispatch and the forward passes index it with the tile
// grid of the actual render size. Rows past that capacity read no or wrong
// lights, which shows up in rooms with local light sources. Sized here for
// 240x135 tiles.
0037AFDC A87EA052   // MOVZ W8,#0x3F5,LSL#16 = buffer size
0037AFEC A87EA0D2   // MOVZ X8,#0x3F5,LSL#16 = buffer create size
0037F3E4 A27EA052   // MOVZ W2,#0x3F5,LSL#16 = 0xFF fill length
// Pool_Uncached size, stock 0x3D00000 (61 MB). Holds both frame copies of the
// light-list buffer.
0030A1C8 0840A152   // MOVZ W8,#0xA00,LSL#16 = 160 MB
@stop

// Resolution sites by Fl4sh (https://github.com/Fl4sh9174). Allocator and
// memory pool fixes reverse-engineered against 1.0.1 and byte-verified
// against the decompressed main.
//
// https://github.com/RAMDRAGONS/switch-patches
